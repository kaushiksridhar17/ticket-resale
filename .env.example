# Copy to .env and fill in before running anything that is reachable
# from outside your own machine. docker compose reads this file.

# Signs session tokens. Any long random string.
AUTH_PEPPER=change-me

# Signs door passes. Anybody holding this can forge a valid ticket.
DOOR_KEY=change-me-too

# The one account that runs the site. It is created the first time the
# engine starts and ignored after that. Running outside Docker, put the
# same three values in engine/admin.json instead.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=pick-something-eight-characters-or-longer
ADMIN_NAME=Your name
