# Copy to .env and fill in before running anything that is reachable
# from outside your own machine. Both docker compose and the engine's
# own dev server read this file.

# Signs session tokens. Any long random string.
AUTH_PEPPER=change-me

# Signs door passes. Anybody holding this can forge a valid ticket.
DOOR_KEY=change-me-too

# The one account that runs the site. It is created the first time the
# engine starts and ignored after that, so change it before the first
# run rather than after. Eight characters is the minimum password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password
ADMIN_NAME=Site admin

# Only needed when running the engine with npm while the database runs
# in Docker. Compose sets its own, so leave this commented out if you
# are running everything with compose.
# DATABASE_URL=postgres://facevalue:facevalue@localhost:5432/facevalue
